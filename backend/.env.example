# Copy to .env and fill in. With no MONGODB_URI the backend uses an in-memory MongoDB (dev only).
# Atlas:   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local:   mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=smartclass
PORT=4000
AUTH_SECRET=change-me-in-prod
LOG_LEVEL=info
# one ESP32 shared across rooms: evidence from any room counts for the only active class (demo only)
SINGLE_ROOM_DEMO=true
