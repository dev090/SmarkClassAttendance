{
  "name": "@smartclass/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --test src/**/*.test.ts src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "reset-db": "node --env-file-if-exists=.env scripts/reset-db.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "ws": "^8.18.1",
    "mongodb": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "mongodb-memory-server-core": "^10.1.4"
  }
}
